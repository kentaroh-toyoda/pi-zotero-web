{
  "name": "pi-zotero-web",
  "version": "0.1.1",
  "description": "Zotero Web API integration for pi: CRUD on items + PDFs, library search, tags & collections, citation export, full-text, and /login zotero key management.",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "zotero"
  ],
  "author": "Kentaroh Toyoda <kentaroh.toyoda@gmail.com> (https://www.linkedin.com/in/kentaroh-toyoda)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentaroh-toyoda/pi-zotero-web.git"
  },
  "homepage": "https://github.com/kentaroh-toyoda/pi-zotero-web",
  "bugs": {
    "url": "https://github.com/kentaroh-toyoda/pi-zotero-web/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "check": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "provider.ts",
    "client.ts",
    "tools.ts",
    "README.md",
    "package.json"
  ]
}